{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "default"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "label": "$string:EntryAbility_label",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ],
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "metadata": [
          {
            "name": "ohos.ability.shortcuts",
            "resource": "$profile:shortcuts_config"
          }
        ]
      },
      {
        "name": "ShortcutAbility",
        "srcEntry": "./ets/entryability/ShortcutAbility.ets",
        "description": "$string:shortcut_ability_desc",
        "label": "$string:EntryAbility_label",
        "exported": true,
        "launchType": "singleton",
        "process": ":shortcut",
        "removeMissionAfterTerminate": true,
        "startWindowIcon": "$media:transparent_pixel",
        "startWindowBackground": "$color:shortcut_transparent"
      }
    ],
    "extensionAbilities": [
      {
        "name": "ClipLinkFormAbility",
        "srcEntry": "./ets/formability/ClipLinkFormAbility.ets",
        "description": "$string:form_desc",
        "type": "form",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:internet_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility",
            "ShortcutAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "$string:shortcut_vibrate_reason",
        "usedScene": {
          "abilities": [
            "ShortcutAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:internet_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility",
            "ShortcutAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.MANAGE_PASTEBOARD_APP_SHARE_OPTION",
        "reason": "$string:internet_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:internet_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}
